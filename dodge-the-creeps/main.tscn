[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://mob.tscn" id="2_mob"]
[ext_resource type="PackedScene" path="res://player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://hud.tscn" id="4_hud"]
[ext_resource type="AudioStream" path="res://audio/music.wav" id="5_music"]
[ext_resource type="AudioStream" path="res://audio/gameover.wav" id="6_over"]

[node name="Main" type="Node"]
script = ExtResource("1_main")
mob_scene = ExtResource("2_mob")

[node name="Background" type="ColorRect" parent="."]
offset_right = 480.0
offset_bottom = 720.0
mouse_filter = 2
color = Color(0.09, 0.1, 0.16, 1)

[node name="Player" parent="." instance=ExtResource("3_player")]

[node name="MobTimer" type="Timer" parent="."]
wait_time = 0.5

[node name="ScoreTimer" type="Timer" parent="."]

[node name="StartTimer" type="Timer" parent="."]
wait_time = 2.0
one_shot = true

[node name="StartPosition" type="Marker2D" parent="."]
position = Vector2(240, 360)

[node name="MobPath" type="Path2D" parent="."]

[node name="MobSpawnLocation" type="PathFollow2D" parent="MobPath"]

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="Music" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("5_music")
max_distance = 100000.0
attenuation = 0.0
panning_strength = 0.0

[node name="DeathSound" type="AudioStreamPlayer2D" parent="."]
stream = ExtResource("6_over")
max_distance = 100000.0
attenuation = 0.0
panning_strength = 0.0

[connection signal="timeout" from="MobTimer" to="." method="_on_mob_timer_timeout"]
[connection signal="timeout" from="ScoreTimer" to="." method="_on_score_timer_timeout"]
[connection signal="timeout" from="StartTimer" to="." method="_on_start_timer_timeout"]
[connection signal="hit" from="Player" to="." method="game_over"]
[connection signal="start_game" from="HUD" to="." method="new_game"]
[connection signal="finished" from="Music" to="." method="_on_music_finished"]
